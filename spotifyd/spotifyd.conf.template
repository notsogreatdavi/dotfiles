[global]
username = "SEU_USERNAME_SPOTIFY"

# Senha gerenciada pelo gnome-keyring (secret-service) — não fica em texto puro.
# Após instalar, armazene com:
#   secret-tool store --label="spotifyd" application spotifyd username "SEU_USERNAME_SPOTIFY"
use_keyring = true

# Backend de áudio: "pulseaudio" ou "pipewire"
backend = "pulseaudio"

device_name = "ArchLinux"
device_type = "speaker"

cache_path = "/home/SEU_USUARIO/.cache/spotifyd"

volume_normalisation = true
use_mpris = false
