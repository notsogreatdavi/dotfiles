# Stratus: tokens em 11.06_visual-identity/design-system.md
# #0C1018 dark.background · #131B28 dark.surface · #1B2637 dark.elevated · #293849 dark.border
# #C8D4E3 text.primary · #7A90A8 text.secondary · #4A5A70 text.muted
# #6BA3E8 accent.primary · #45C4C4 accent.highlight · #E0B84A status.warning · #CC6070 status.error

[global]
    font = Geist 10
    markup = full
    # Título Geist 600 em 14px, corpo em text.secondary a 13px (Geist 10pt a 96dpi)
    format = "<span weight='600' size='10.5pt'>%s</span>\n<span foreground='#7A90A8'>%b</span>"

    width = 360
    height = (0, 200)
    origin = top-right
    # 24 da borda; 60 = polybar (8 + 36) + spacing.md
    offset = (24, 60)

    corner_radius = 5
    corners = all
    frame_width = 1
    frame_color = "#293849"
    gap_size = 8

    separator_height = 1
    separator_color = frame
    padding = 16
    horizontal_padding = 16
    text_icon_padding = 16

    progress_bar = true
    progress_bar_height = 4
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 2
    progress_bar_min_width = 150
    # Largura = 360 - padding 16 - ícone 32 - 16 - padding 16, alinhada à direita
    # para começar junto do texto (o padrão é centralizar)
    progress_bar_max_width = 280
    progress_bar_horizontal_alignment = right

    # Ícones do design em ~/.config/dunst/icons (SVG 32px com a caixa dark.elevated);
    # a busca recursiva ignora o icon_path, por isso os scripts passam o caminho inteiro
    icon_position = left
    min_icon_size = 32
    max_icon_size = 32
    enable_recursive_icon_lookup = true
    icon_theme = Adwaita

    alignment = left
    vertical_alignment = center
    line_height = 2
    ellipsize = middle
    show_age_threshold = 60
    stack_duplicates = true
    notification_limit = 5

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

    follow = mouse
    sort = yes
    sticky_history = yes
    history_length = 20
    # Botões de ação não são desenhados pelo dunst: abrem neste menu ($mod+period)
    dmenu = /usr/bin/rofi -dmenu -no-config -p Ações -theme ~/.config/polybar/scripts/rofi/menu.rasi
    browser = /usr/bin/xdg-open

[urgency_low]
    background = "#0C1018"
    foreground = "#7A90A8"
    frame_color = "#293849"
    highlight = "#7A90A8"
    timeout = 8
    # Uma linha só, ícone de 16px sem caixa
    format = "%s · %b"
    min_icon_size = 16
    max_icon_size = 16
    default_icon = /home/notsogreatdavi/.config/dunst/icons/stratus-music.svg

[urgency_normal]
    background = "#131B28"
    foreground = "#C8D4E3"
    frame_color = "#293849"
    highlight = "#6BA3E8"
    timeout = 10
    default_icon = /home/notsogreatdavi/.config/dunst/icons/stratus-info.svg

[urgency_critical]
    background = "#131B28"
    foreground = "#C8D4E3"
    frame_color = "#CC6070"
    highlight = "#CC6070"
    timeout = 0
    default_icon = /home/notsogreatdavi/.config/dunst/icons/stratus-warning.svg

# Volume e brilho (bin/osd): uma notificação que se substitui, valor em VictorMono
[osd]
    appname = osd
    format = "<span weight='600' size='10.5pt'>%s</span>   <span font_desc='VictorMono Nerd Font 10'>%b</span>"
    timeout = 2
    history_ignore = yes
