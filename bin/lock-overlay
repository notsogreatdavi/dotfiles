#!/usr/bin/env bash
# Desenha na imagem da lockscreen o que o i3lock-color não sabe desenhar (artboard "Lock"):
# o miolo do anel com a digital e, no canto inferior esquerdo, a nuvem Stratus + usuário.
# Parte do wall_dimblur.png, que o betterlockscreen gera igual ao lock_dimblur.png e não
# é usado como wallpaper: dá para rodar de novo sem empilhar desenhos.

CACHE="$HOME/.cache/betterlockscreen/current"
SOURCE="$CACHE/wall_dimblur.png"
TARGET="$CACHE/lock_dimblur.png"
FONT="/usr/share/fonts/TTF/Geist-Regular.ttf"

ACCENT="#6BA3E8"
TEXT_DIM="#7A90A8"
RING_FILL="rgba(12,16,24,0.6)"

RADIUS=64          # igual ao --radius do betterlockscreenrc
RING_Y_RATIO=0.62  # igual ao --ind-pos (y+h*0.62)

# SVG do artboard: digital de 40px e a nuvem de 36x16
fingerprint_svg() {
    cat <<SVG
<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="$ACCENT" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9a9 9 0 0 1 16 0"/><path d="M6 12a6 6 0 0 1 12 0v1"/><path d="M9 12a3 3 0 0 1 6 0v2a6 6 0 0 1-1 3"/><path d="M12 12v3a4 4 0 0 1-1 3"/><path d="M6 15a7 7 0 0 0 1 3"/><path d="M18 16a8 8 0 0 1-1 3"/></svg>
SVG
}

cloud_svg() {
    cat <<SVG
<svg xmlns="http://www.w3.org/2000/svg" width="36" height="16" viewBox="0 0 60 26" fill="none" stroke="$ACCENT" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20H56C59 20 60 17 57 15C57 11 52 10 49 12C47 7 40 6 36 9C33 5 25 5 22 9C18 7 12 9 12 13C7 13 3 16 4 20Z" stroke-width="2.2"/><path d="M12 24.5H48" stroke-width="1.4" opacity="0.6"/></svg>
SVG
}

# Uma linha "largura altura x y" por monitor ativo
monitor_geometries() {
    xrandr --listactivemonitors | awk 'NR > 1 {
        split($3, g, /[\/x+]/); print g[1], g[3], g[5], g[6]
    }'
}

main() {
    local tmp args=() w h x y cx cy
    [[ -f "$SOURCE" ]] || { echo "sem $SOURCE: rode lock-update" >&2; exit 1; }
    tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
    fingerprint_svg > "$tmp/fingerprint.svg"
    cloud_svg > "$tmp/cloud.svg"

    while read -r w h x y; do
        cx=$(( x + w / 2 ))
        cy=$(awk -v y="$y" -v h="$h" -v r="$RING_Y_RATIO" 'BEGIN { printf "%d", y + h * r }')
        args+=(
            -fill "$RING_FILL" -stroke none
            -draw "circle $cx,$cy $((cx + RADIUS)),$cy"
            \( -background none "$tmp/fingerprint.svg" \) -geometry "+$((cx - 20))+$((cy - 20))" -composite
            \( -background none "$tmp/cloud.svg" \) -geometry "+$((x + 48))+$((y + h - 40 - 16))" -composite
            -font "$FONT" -pointsize 14 -fill "$TEXT_DIM"
            -annotate "+$((x + 48 + 36 + 12))+$((y + h - 40 - 3))" "$USER"
        )
    done < <(monitor_geometries)

    magick "$SOURCE" "${args[@]}" "$TARGET"
}

main
