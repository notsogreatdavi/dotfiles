#!/bin/bash
pids=()

while IFS= read -r line; do
    output=$(echo "$line" | awk '{print $1}')
    geometry=$(echo "$line" | grep -oP '\d+x\d+\+\d+\+\d+')
    [ -z "$geometry" ] && continue

    x=$(echo "$geometry" | grep -oP '(?<=\+)\d+' | head -1)
    y=$(echo "$geometry" | grep -oP '(?<=\+)\d+' | tail -1)
    w=$(echo "$geometry" | grep -oP '^\d+')
    h=$(echo "$geometry" | grep -oP 'x\K\d+')

    i3-msg "focus output $output" >/dev/null 2>&1
    sleep 0.3

    ghostty --fullscreen=true -e drift --scene life --theme nord &
    pid=$!
    pids+=($pid)

    # aguarda janela aparecer e move para o monitor correto
    for _ in $(seq 1 10); do
        wid=$(xdotool search --pid "$pid" --onlyvisible 2>/dev/null | tail -1)
        [ -n "$wid" ] && break
        sleep 0.1
    done
    [ -n "$wid" ] && xdotool windowmove "$wid" "$x" "$y" 2>/dev/null

    sleep 0.2
done < <(xrandr | grep " connected" | grep -oP '^\S+.*\d+x\d+\+\d+\+\d+')

wait "${pids[@]}"
