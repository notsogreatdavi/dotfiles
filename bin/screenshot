#!/usr/bin/env bash
# Captura região da tela e copia para o clipboard.
# Para garantir 100% de opacidade, coloque a janela alvo em fullscreen ($mod+f no i3)
# antes de disparar — o picom força opacity=1.0 em janelas com _NET_WM_STATE_FULLSCREEN.
set -euo pipefail

readonly OUT_DIR="$HOME/Pictures/Screenshots"
readonly TIMESTAMP="$(date +%Y-%m-%d_%H-%M-%S)"
readonly OUT_FILE="$OUT_DIR/screenshot-$TIMESTAMP.png"

capture_region() {
    maim -s "$OUT_FILE"
}

copy_to_clipboard() {
    xclip -selection clipboard -t image/png -i "$OUT_FILE"
}

# O dunst não desenha botões: as ações abrem no menu de contexto ($mod+period).
# O dunstify espera a escolha, por isso roda em segundo plano
notify_saved() {
    local shown="${OUT_FILE/#$HOME/\~}" action
    action=$(dunstify -i "$HOME/.config/dunst/icons/stratus-screenshot.svg" \
        -A "open,abrir" -A "copy,copiar caminho" \
        "Captura salva" "<span font_desc='VictorMono Nerd Font 9'>$shown</span>
<span foreground='#4A5A70' size='9pt'>super+.  abrir · copiar caminho</span>")
    case "$action" in
        open) xdg-open "$OUT_FILE" ;;
        copy) printf '%s' "$OUT_FILE" | xclip -selection clipboard ;;
    esac
}

main() {
    mkdir -p "$OUT_DIR"
    capture_region || exit 1
    copy_to_clipboard
    notify_saved &
    disown
}

main "$@"
