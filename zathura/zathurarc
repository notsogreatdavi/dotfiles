# --- Cores Stratus (11.06_visual-identity/design-system.md) ---
set default-bg                  "#0C1018"
set default-fg                  "#C8D4E3"
set statusbar-bg                "#131B28"
set statusbar-fg                "#7A90A8"
set inputbar-bg                 "#131B28"
set inputbar-fg                 "#C8D4E3"
set notification-bg             "#131B28"
set notification-fg             "#C8D4E3"
set notification-error-bg       "#131B28"
set notification-error-fg       "#CC6070"
set notification-warning-bg     "#131B28"
set notification-warning-fg     "#E0B84A"
set highlight-color             "rgba(69,196,196,0.3)"
set highlight-active-color      "rgba(107,163,232,0.5)"
set completion-bg               "#131B28"
set completion-fg               "#7A90A8"
set completion-group-bg         "#0C1018"
set completion-group-fg         "#4A5A70"
set completion-highlight-bg     "#1B2637"
set completion-highlight-fg     "#C8D4E3"
set index-bg                    "#0C1018"
set index-fg                    "#C8D4E3"
set index-active-bg             "#1B2637"
set index-active-fg             "#6BA3E8"
set recolor-lightcolor          "#0C1018"
set recolor-darkcolor           "#C8D4E3"
set font                        "Geist 10"

# --- Opções de Comportamento ---
set selection-clipboard         clipboard
set recolor                     "true"
set render-loading              "false"
set scroll-step                 50
set synctex true
set synctex-editor-command "nvim --headless -c \"VimtexInverseSearch %l '%f'\""
