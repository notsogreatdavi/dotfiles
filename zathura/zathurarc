# Configurações de cores Nord para Zathura
set default-bg                  "#2E3440"
set default-fg                  "#D8DEE9"
set statusbar-bg                "#3B4252"
set statusbar-fg                "#D8DEE9"
set inputbar-bg                 "#2E3440"
set inputbar-fg                 "#EBCB8B"
set notification-error-bg       "#BF616A"
set notification-error-fg       "#D8DEE9"
set notification-warning-bg     "#D08770"
set notification-warning-fg     "#D8DEE9"
set highlight-color             "#88C0D0"
set highlight-active-color      "#81A1C1"
set completion-bg               "#3B4252"
set completion-fg               "#88C0D0"
set completion-highlight-bg     "#88C0D0"
set completion-highlight-fg     "#2E3440"
set recolor-lightcolor          "#2E3440"
set recolor-darkcolor           "#ECEFF4"

# --- Opções de Comportamento ---
set selection-clipboard         clipboard
set recolor                     "true"
set render-loading              "false"
set scroll-step                 50
set synctex true
set synctex-editor-command "nvim --headless -c \"VimtexInverseSearch %l '%f'\""
