configuration {
    font:            "VictorMono Nerd Font 10";
    show-icons:      false;
    hide-scrollbar:  true;
    sidebar-mode:    false;
}

@import "colors.rasi"

window {
    transparency:     "real";
    background-color: @bg;
    text-color:       @fg;
    border:           1px;
    border-color:     @ac;
    border-radius:    5px;
    width:            260px;
    location:         northeast;
    anchor:           northeast;
    y-offset:         44px;
    x-offset:         -8px;
}

prompt {
    enabled:          true;
    padding:          6px 8px;
    background-color: @bga;
    text-color:       @ac;
}

entry {
    background-color: @al;
    text-color:       @al;
    placeholder:      "";
    expand:           false;
    width:            0px;
}

inputbar {
    children:         [ prompt ];
    background-color: @bga;
    expand:           false;
    border:           0px;
    margin:           0px;
    padding:          0px;
}

listview {
    background-color: @al;
    padding:          4px;
    columns:          1;
    lines:            8;
    spacing:          2px;
    cycle:            true;
    dynamic:          true;
    layout:           vertical;
}

mainbox {
    background-color: @al;
    border:           0px;
    children:         [ inputbar, listview ];
    spacing:          0px;
    padding:          0px;
}

element {
    background-color: @al;
    text-color:       @fga;
    orientation:      horizontal;
    border-radius:    4px;
    padding:          6px 10px;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    expand:           true;
    horizontal-align: 0;
    vertical-align:   0.5;
}

element selected {
    background-color: @se;
    text-color:       @fg;
    border:           1px;
    border-radius:    4px;
    border-color:     @ac;
}
