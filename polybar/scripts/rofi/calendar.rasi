configuration {
    font:            "VictorMono Nerd Font 10";
    show-icons:      false;
    hide-scrollbar:  true;
    sidebar-mode:    false;
    markup-rows:     true;
}

@import "colors.rasi"

window {
    transparency:     "real";
    background-color: @bg;
    text-color:       @fg;
    border:           1px;
    border-color:     @bd;
    border-radius:    5px;
    width:            196px;
    location:         northeast;
    anchor:           northeast;
    y-offset:         52px;
    x-offset:         -8px;
}

prompt {
    enabled:          true;
    padding:          4px 5px;
    background-color: @bga;
    text-color:       @ac;
}

entry {
    enabled:          false;
}

inputbar {
    children:         [ prompt ];
    background-color: @bga;
    expand:           false;
    border:           0px;
    margin:           0px;
    padding:          0px;
}

listview {
    background-color: @al;
    padding:          2px;
    columns:          1;
    lines:            12;
    spacing:          1px;
    cycle:            false;
    dynamic:          false;
    layout:           vertical;
}

mainbox {
    background-color: @al;
    border:           0px;
    children:         [ inputbar, listview ];
    spacing:          0px;
    padding:          0px;
}

element {
    background-color: @al;
    text-color:       @fga;
    orientation:      horizontal;
    border-radius:    5px;
    padding:          1px 3px;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    font:             "VictorMono Nerd Font Mono 10";
    expand:           true;
    horizontal-align: 0;
    vertical-align:   0.5;
}

element selected {
    background-color: @se;
    text-color:       @fg;
    border:           0px;
    border-radius:    5px;
}
