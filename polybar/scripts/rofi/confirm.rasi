/* Stratus: diálogo de confirmação (substitui o i3-nagbar) */

configuration {
    show-icons:     false;
    hide-scrollbar: true;
}

@import "colors.rasi"

window {
    transparency:     "real";
    background-color: @bg;
    border:           1px;
    border-color:     @bd;
    border-radius:    5px;
    width:            380px;
    location:         center;
    anchor:           center;
}

mainbox {
    background-color: @al;
    children:         [ inputbar, message, box-actions ];
    padding:          24px;
    spacing:          16px;
}

inputbar {
    background-color: @al;
    children:         [ textbox-icon, prompt ];
    spacing:          8px;
}

textbox-icon {
    background-color: @al;
    text-color:       @wn;
    font:             "VictorMono Nerd Font Propo 14";
    expand:           false;
    str:              "󰀪";
    vertical-align:   0.5;
}

prompt {
    background-color: @al;
    text-color:       @fg;
    font:             "Geist SemiBold 13";
    vertical-align:   0.5;
}

message {
    background-color: @al;
}

textbox {
    background-color: @al;
    text-color:       @fga;
    font:             "Geist 11";
}

/* Botões à direita: um dummy de largura fixa empurra a lista, que divide os
 * 222px restantes (380 − padding 48 − 110) em duas colunas de ~107px. Colunas
 * fixas cabem "suspender", "reiniciar" e "desligar" sem cortar o botão de ação. */
box-actions {
    background-color: @al;
    orientation:      horizontal;
    children:         [ dummy, listview ];
}

dummy {
    background-color: @al;
    expand:           false;
    width:            110px;
}

listview {
    background-color: @al;
    layout:           vertical;
    columns:          2;
    lines:            1;
    fixed-columns:    true;
    spacing:          8px;
    dynamic:          false;
}

element {
    background-color: @bga;
    text-color:       @fg;
    border:           1px;
    border-color:     @bd;
    border-radius:    5px;
    padding:          8px 16px;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    horizontal-align: 0.5;
    font:             "Geist 11";
}

element selected {
    background-color: @se;
    border-color:     @ac;
}

/* Ação destrutiva preenchida em status.error; o foco é sempre a borda accent */
element urgent {
    background-color: @er;
    border-color:     @er;
    text-color:       @bg;
}

element selected urgent {
    background-color: @er;
    border-color:     @ac;
    text-color:       @bg;
}
