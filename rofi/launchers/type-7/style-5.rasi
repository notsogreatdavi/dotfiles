/* Stratus: launcher (apps, run, janelas, arquivos)
 * Cores do hub compartilhado com os menus da polybar. */

configuration {
    modi:                "drun,run,window,filebrowser";
    show-icons:          true;
    display-drun:        "apps";
    display-run:         "run";
    display-window:      "janelas";
    display-filebrowser: "arquivos";
    drun-display-format: "{name}\n<span size='small' foreground='#7A90A8'>{generic}</span>";
    window-format:       "{c}\n<span size='small' foreground='#7A90A8'>{t}</span>";
    /* Tab troca de modo como no rodapé; a lista anda só pelas setas */
    kb-element-next:     "";
    kb-mode-next:        "Tab,Control+Tab,Shift+Right";
}

@import "~/.config/polybar/scripts/rofi/colors.rasi"

* {
    background-color: transparent;
    text-color:       @fg;
    font:             @ui-font;
}

window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    width:            640px;
    background-color: @bg;
    border:           1px;
    border-color:     @bd;
    border-radius:    5px;
}

mainbox {
    orientation:      vertical;
    children:         [ header, inputbar, message, listview, textbox-hint ];
    spacing:          0px;
}

/* ─── Cabeçalho: cloud mark, wordmark e modos ─── */

header {
    expand:           false;
    orientation:      horizontal;
    children:         [ textbox-mark, textbox-brand, mode-switcher ];
    padding:          16px 16px 0px 16px;
    spacing:          8px;
}

textbox-mark {
    expand:           false;
    str:              "󰅣";
    text-color:       @fga;
    font:             "VictorMono Nerd Font Propo 18";
    vertical-align:   0.5;
}

textbox-brand {
    expand:           true;
    str:              "stratus";
    text-color:       @fga;
    vertical-align:   0.5;
}

mode-switcher {
    expand:           false;
    fixed-columns:    false;
    spacing:          4px;
}

button {
    expand:           false;
    padding:          4px 8px;
    border-radius:    5px;
    text-color:       @fga;
    font:             "Geist 10";
    cursor:           pointer;
}

button selected {
    background-color: @se;
    text-color:       @fg;
}

/* ─── Busca ─── */

inputbar {
    children:         [ textbox-search, entry, num-filtered-rows, textbox-of, num-rows ];
    margin:           16px;
    padding:          12px 16px;
    spacing:          8px;
    background-color: @bga;
    border:           1px;
    border-color:     @ac;
    border-radius:    5px;
}

textbox-search {
    expand:           false;
    str:              "󰍉";
    text-color:       @hl;
    font:             @mono-font;
    vertical-align:   0.5;
}

entry {
    font:             @mono-font;
    placeholder:      "buscar";
    placeholder-color: @mu;
    cursor:           text;
    vertical-align:   0.5;
}

num-filtered-rows, num-rows {
    text-color:       @mu;
    font:             "VictorMono Nerd Font 9";
    vertical-align:   0.5;
}

textbox-of {
    expand:           false;
    str:              "de";
    text-color:       @mu;
    font:             "VictorMono Nerd Font 9";
    vertical-align:   0.5;
}

/* ─── Lista ─── */

listview {
    columns:          1;
    lines:            7;
    cycle:            true;
    dynamic:          true;
    fixed-height:     false;
    scrollbar:        false;
    padding:          0px 8px 8px 8px;
    spacing:          2px;
}

element {
    orientation:      horizontal;
    children:         [ element-icon, element-text, textbox-key ];
    padding:          8px 12px;
    spacing:          12px;
    border-radius:    5px;
    cursor:           pointer;
}

element selected.normal,
element selected.active {
    background-color: @se;
}

element-icon {
    size:             22px;
    padding:          6px;
    background-color: @bga;
    border:           1px;
    border-color:     @bd;
    border-radius:    5px;
    cursor:           inherit;
}

element-text {
    text-color:       @fg;
    highlight:        #45C4C4;
    vertical-align:   0.5;
    cursor:           inherit;
}

/* Tecla "enter" visível só na linha selecionada */
textbox-key {
    expand:           false;
    str:              "enter";
    font:             "VictorMono Nerd Font 9";
    padding:          2px 6px;
    border:           1px;
    border-radius:    5px;
    border-color:     transparent;
    text-color:       transparent;
    vertical-align:   0.5;
}

textbox-key selected.normal,
textbox-key selected.active {
    border-color:     @bd;
    text-color:       @fga;
}

/* ─── Rodapé e mensagens ─── */

textbox-hint {
    expand:           false;
    str:              "tab muda modo    ctrl+enter executa como run";
    text-color:       @mu;
    font:             "Geist 10";
    padding:          8px 16px;
    border:           1px 0px 0px 0px;
    border-color:     @bd;
}

message {
    padding:          0px 16px 8px 16px;
}

textbox {
    text-color:       @fga;
}

error-message {
    padding:          16px;
    background-color: @bg;
    text-color:       @er;
}
