/**
 * Rofi Theme - Nord
 * Adapted for notsogreatdavi by Gemini
 */

/*****----- Global Properties -----*****/
* {
    /* Stratus palette */
    background:                  #0C1018; /* dark.background */
    background-alt:              #131B28; /* dark.surface */
    text:                        #7A90A8; /* text.secondary */
    text-primary:                #C8D4E3; /* text.primary */
    primary:                     #6BA3E8; /* accent.primary */
    secondary:                   #8B6FBE; /* accent.secondary */
    urgent:                      #8B6FBE; /* accent.secondary */

    font:                        "VictorMono Nerd Font 10";
}

/*****----- Configuration -----*****/
configuration {
    modi:                        "drun,filebrowser,window";
    show-icons:                  true;
    display-drun:                " Apps";
    display-filebrowser:         " Files";
    display-window:              " Windows";
    drun-display-format:         "{name}";
    window-format:               "{w} · {c} · {t}";
}

/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    width:                       600px;
    border-radius:               5px;
    background-color:            @background;
}

/*****----- Main Box -----*****/
mainbox {
    spacing:                     15px;
    padding:                     20px;
    background-color:            transparent;
    orientation:                 vertical;
    children:                    [ "mode-switcher", "inputbar", "listbox" ];
}

listbox {
    padding:                     10px;
    background-color:            transparent;
    orientation:                 vertical;
    children:                    [ "message", "listview" ];
}

/*****----- Mode Switcher (Centralizado) -----*****/
mode-switcher {
    enabled:                     true;
    spacing:                     20px;
    background-color:            transparent;
    text-color:                  @text;
    horizontal-align:            0.5; /* Centraliza horizontalmente */
}
button {
    padding:                     10px 15px;
    border-radius:               5px;
    background-color:            @background-alt;
    text-color:                  inherit;
    cursor:                      pointer;
}
button selected {
    background-color:            @primary;
    text-color:                  @background;
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    spacing:                     15px;
    padding:                     15px;
    border-radius:               5px;
    background-color:            @background-alt;
    text-color:                  @text;
    orientation:                 horizontal;
    children:                    [ "textbox-prompt-colon", "entry"];
}
textbox-prompt-colon {
    enabled:                     true;
    expand:                      false;
    str:                         "";
    padding:                     10px 15px;
    border-radius:               5px;
    background-color:            @secondary;
    text-color:                  @text-primary;
}
entry {
    padding:                     10px 16px;
    border-radius:               5px;
    background-color:            @background-alt;
    text-color:                  inherit;
    cursor:                      text;
    placeholder:                 "Search...";
    placeholder-color:           inherit;
}

/*****----- Listview -----*****/
listview {
    columns:                     1;
    lines:                       8;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    spacing:                     10px;
    background-color:            transparent;
    text-color:                  @text;
}

/*****----- Elements -----*****/
element {
    padding:                     10px;
    border-radius:               5px;
    background-color:            transparent;
    text-color:                  @text;
    cursor:                      pointer;
}
element normal.normal {
    background-color:            @background-alt;
    text-color:                  inherit;
}
element selected.normal {
    background-color:            @primary;
    text-color:                  @background;
}
element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        24px;
    cursor:                      inherit;
}
element-text {
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
}

/*****----- Message -----*****/
message {
    background-color:            transparent;
}
textbox {
    padding:                     12px;
    border-radius:               5px;
    background-color:            @background-alt;
    text-color:                  @text;
}
error-message {
    padding:                     12px;
    border-radius:               5px;
    background-color:            @background;
    text-color:                  @urgent;
}
