/**
 * Rofi Powermenu - Nord Theme (Simple & Centered)
 * Adaptado para notsogreatdavi by Gemini
 */

/*****----- Global Properties -----*****/

configuration {
    show-icons: false;

  }
* {
    /* Stratus palette */
    background:                  #0C1018; /* dark.background */
    background-alt:              #131B28; /* dark.surface */
    foreground:                  #C8D4E3; /* text.primary */
    selected:                    #6BA3E8; /* accent.primary */
    urgent:                      #CC6070; /* status.error */

    font:                        "VictorMono Nerd Font 12";
}

/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    width:                       250px; /* Largura menor para um menu vertical */
    border-radius:               5px;
    background-color:            @background;
    children:                    [ "mainbox" ];
}

/*****----- Main Box -----*****/
mainbox {
    padding:                     15px;
    background-color:            transparent;
    children:                    [ "inputbar", "listview" ];
}

/*****----- Inputbar (Título) -----*****/
inputbar {
    padding:                     10px;
    border-radius:               5px;
    background-color:            @background-alt;
    text-color:                  @selected;
    children:                    [ "prompt" ];
}

prompt {
    enabled:                     true;
    background-color:            inherit;
    text-color:                  inherit;
    horizontal-align:            0.5;
}

/*****----- Listview (Opções) -----*****/
listview {
    lines:                       4; /* 4 opções: Lock, Logout, Reboot, Shutdown */
    cycle:                       false;
    scrollbar:                   false;
    layout:                      vertical;
    spacing:                     10px;
    padding:                     10px 0px 0px;
    background-color:            transparent;
}

/*****----- Elements -----*****/
element {
    padding:                     10px 15px;
    border-radius:               5px;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      pointer;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    horizontal-align:            -1; /* Centraliza o texto/ícone */
}

element selected {
    background-color:            @selected;
    text-color:                  @background;
}
element selected.urgent {
    background-color:            @urgent;
    text-color:                  @background;
}
